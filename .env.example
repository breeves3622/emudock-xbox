# ==============================================================================
# EmuDock Xbox Stack - Portainer Environment Variables Configuration Template
# ==============================================================================

# System User & Timezone
PUID=1000
PGID=1000
TZ=America/New_York

# Sunshine Admin Dashboard Credentials
SUNSHINE_USER=admin
SUNSHINE_PASS=ChangeMeToASecurePassword123!

# GPU Hardware Acceleration (NVIDIA, Intel, or AMD)
# For NVIDIA GPUs: Set to "all" and ensure nvidia-container-toolkit is installed on host
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# ------------------------------------------------------------------------------
# SMB / CIFS Network Drive Settings (Guest Access on \\10.80.1.50\Public)
# ------------------------------------------------------------------------------
SMB_USER=guest
SMB_PASS=
SMB_DOMAIN=WORKGROUP
# Network UNC Paths
SMB_ROMS_PATH=//10.80.1.50/Public/roms
SMB_BIOS_PATH=//10.80.1.50/Public/bios

# ------------------------------------------------------------------------------
# NFS Network Drive Settings (Alternative)
# ------------------------------------------------------------------------------
NFS_SERVER_IP=10.80.1.50
NFS_ROMS_PATH=/Public/roms
NFS_BIOS_PATH=/Public/bios

# ------------------------------------------------------------------------------
# RomM Alternative Stack Settings (Optional)
# ------------------------------------------------------------------------------
DB_PASSWORD=romm_db_secure_password
DB_ROOT_PASSWORD=romm_root_secure_password
AUTH_SECRET_KEY=ReplaceWithRandom32CharacterStringForSecurity
IGDB_CLIENT_ID=your_twitch_igdb_client_id
IGDB_CLIENT_SECRET=your_twitch_igdb_client_secret
